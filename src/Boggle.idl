module Boggle{
    exception AlreadyLoggedIn{};
    exception IsNotUser{};
    exception GameNotStarted{};


    struct Player{
        string id;
        string username;
        string password;
        long highScore;
    };

    struct Game{
        long round;
        sequence <Player> players;
        sequence <long> playerScoreInRound;
        sequence <long> playerScoreInGame;
    };

    interface ClientInterface{
        typedef sequence <char> CharSeq;
        typedef sequence <long> IntSeq;

        IntSeq getLeaderBoards();
        void logIn(in string username, in string getPassword) raises (AlreadyLoggedIn, IsNotUser);
        void startGame(in string username);
        long getRoundTime(in string username);
        long getWaitingTime(in string username);
        CharSeq getLetters(in string username);
        long submitWord(in string word, in string username);
        long getScore(in string username);
        string getRoundWinner(in string username);
    };
};