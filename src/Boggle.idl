module Boggle{

    struct Player{
        string id;
        string username;
        string password;
        long highScore;
    };

    struct Game{
        long round;
        sequence <Player> players;
        sequence <long> playerScoreInRound;
        sequence <long> playerScoreInGame;
    };

    interface ClientInterface{
        void logIn(in string username, in string getPassword);
        boolean isLoggedIn();
        void startGame();
        long submitWord(in string word);
        long getScore();
    };

};