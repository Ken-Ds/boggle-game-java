module Boggle{
    exception AlreadyLoggedIn{};
        exception IsNotUser{};
        exception GameNotStarted{};

        interface ClientInterface{
        typedef sequence <char> CharSeq;
        typedef sequence <long> IntSeq;
        typedef sequence <string> StringSeq;

        IntSeq getLeaderBoards();
        void logIn(in string username, in string password) raises (AlreadyLoggedIn, IsNotUser);
        StringSeq getLeaderBoardsNames();
        IntSeq getLeaderBoardsScores();
        void startGame(in string username);
        long getRoundTime(in string username);
        long getWaitingTime(in string username);
        CharSeq getLetters(in string username);
        void submitWord(in string word, in string username);
        StringSeq getGamePlayers(in string username);
        IntSeq getRoundScores(in string username);
        IntSeq getGameScores(in string username);
        IntSeq getOverAllScores(in string username);
        string getRoundWinner(in string username);
        boolean gameStatus(in string username);
        void logOut (in string username);
        string getGameWinner(in string username);
        long getGameWinnerOverAllScore(in string username);
        boolean thereIsWinner(in string username);
        };
        };
